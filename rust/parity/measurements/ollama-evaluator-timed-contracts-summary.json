  "production_changes": [
    {
      "problem": "Last cancelled classify could return before its evaluator request/body future was dropped.",
      "fix": "Retain exact Arc<Entry> with a persistent completion witness; construct guard before spawn; evaluator future ends before completion; detach cancelled peers and await only exact old work when no live peer remains."
    },
    {
      "problem": "Shutdown published Cancelled could be overwritten by worker late Ok before the waiter read the watch.",
      "fix": "Check retained exact controller cancellation before returning any non-cancelled result; use the same cancellation/cleanup path and never act on replacement entry."
    }
  ],
  "api_adaptation": [
    {
      "assertions": [
        "test/ollama-evaluator.test.mjs#7:assert-5"
      ],
      "javascript": "Exact same AbortSignal object across metadata and inference.",
      "rust": "One production controller and cumulative deadline across the two phases, with deterministic 39/40 ms boundary after 10 ms metadata.",
      "identity_equivalence": false,
      "limitation": "HttpTransport does not expose a JavaScript signal object; native signal-object identity is not representable."
    },
    {
      "assertions": [
        "test/ollama-evaluator.test.mjs#9:assert-1",
        "test/ollama-evaluator.test.mjs#10:assert-1"
      ],
      "javascript": "Rejected value is the exact arbitrary caller Error object.",
      "rust": "Caller-owned CancellationToken and EvaluationError::Cancelled, preserving cancellation/no-I/O/body-release/retry semantics.",
      "identity_equivalence": false,
      "limitation": "Arbitrary JavaScript Error reason and object identity are absent from the Rust API; embeddings retain their reason beside the token. This limitation remains explicit even if the finite port is marked covered."
    },
    {
      "assertions": [
        "test/ollama-evaluator.test.mjs#8:assert-1",
        "test/ollama-evaluator.test.mjs#8:assert-2"
      ],
      "javascript": "Both absent signal and supplied live signal; same signal used for sequential zero/positive budget calls; AbortError or TimeoutError accepted.",
      "rust": "Absent signal maps to a fresh owned uncancelled token; supplied signal maps to its owned token. Each pair reuses that same token; positive deadline returns typed Timeout.",
      "identity_equivalence": false,
      "limitation": "No global equivalence of JS exceptions or optional-signal identity is claimed."
    }
  ],
