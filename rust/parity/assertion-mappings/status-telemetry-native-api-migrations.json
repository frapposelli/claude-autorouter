  "migration_contracts": [
    {
      "id": "optional_undefined",
      "native_boundary": "Own optional JS undefined maps to absent JSON field, never Null. None is an absent normalizer result; output absent field is tested via absence, not null. Top-level undefined is not an argument of &Value/&JsDocument; the host handles missing input before call.",
      "affected": [
        "status14",
        "status15",
        "status18",
        "telemetry6",
        "telemetry8",
        "telemetry10"
      ],
      "nonclaim": "No ownership-preserving own-undefined native value, no null-as-undefined substitution."
    },
    {
      "id": "host_json_input",
      "native_boundary": "Borrowed Value/JsDocument are data trees without host Error instances, executable property accessors or cyclic host references. Host objects must be converted/validated before this boundary. Unknown host Error can be represented only as inert explicitly synthetic extra for allowlist/privacy checks.",
      "affected": [
        "status14",
        "status15",
        "status18",
        "telemetry1",
        "telemetry10"
      ],
      "nonclaim": "Original Source Error/cycle/getter tests remain actual Source evidence, not native executions or a promise to catch arbitrary panicking custom callbacks. JsDocument nonfinite Number/UTF16 behavior is retained separately, not erased as Null."
    },
    {
      "id": "typed_options",
      "native_boundary": "StatusOptions contains owned PathBuf and explicit I/O/clock adapters. A property getter that throws during option lookup has no corresponding native option operation. Ordinary unavailable paths still fail soft with None and owned close behavior.",
      "affected": [
        "status18"
      ],
      "nonclaim": "Unavailable-directory native test is not execution of a throwing JavaScript directory getter; no blanket custom-adapter panic containment."
    },
    {
      "id": "owned_close_future",
      "native_boundary": "StatusStore::close().await seals update admission on first poll. Separate close futures join one retained worker/readiness ownership chain and drain latest accepted state before removal; waiter cancellation leaves task handles owned for later close.",
      "affected": [
        "status21"
      ],
      "nonclaim": "No shared JS Promise reference identity, no unpolled-future or dropped-store awaited-drain promise, no universal denied-remove/crash/runtime-shutdown cleanup. Actual normal owned FS schedules remain specifically bounded."
    }
  ],
