+            .filter(|e| matches!(
+                e,
+                Event::FlushPolled {
+                    total_input_bytes: 1,
+                    ..
+                }
+            ))
+            .count(),
+        2
+    );
+    h.io.lock()
+        .unwrap()
+        .input
+        .extend(b"GET /b HTTP/1.1\r\nhost: synthetic.invalid\r\n\r\n");
+    h.prepare();
+    assert!(h.write().is_pending());
+    ready_ok(h.flush());
+    assert!(h.driver.body_handoff.is_none());
+    assert_eq!(h.events("A"), old);
+}
