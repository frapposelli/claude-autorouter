+fn construct(
+    groups: &CStr,
+    constructor: impl FnOnce() -> *mut ffi::SSL_CTX,
+) -> Result<SslContextBuilder, ErrorStack> {
+    register()?;
+    let guard = Guard::begin(groups)?;
+    let context = constructor();
+    unsafe { guard.finish(context) }
