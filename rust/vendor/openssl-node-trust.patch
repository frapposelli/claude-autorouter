+#[cfg(ossl300)]
+impl X509LookupRef<Store> {
+    /// Registers a URI for lazy lookup, preserving OpenSSL's directory policy.
+    pub fn add_store(&mut self, uri: &std::ffi::CStr) -> Result<(), ErrorStack> {
+        // X509_LOOKUP_add_store is this macro in OpenSSL's public x509_vfy.h.
+        const X509_L_ADD_STORE: libc::c_int = 3;
+        unsafe {
+            cvt(ffi::X509_LOOKUP_ctrl(
+                self.as_ptr(),
+                X509_L_ADD_STORE,
+                uri.as_ptr(),
+                0,
+                std::ptr::null_mut(),
+            ))
+            .map(|_| ())
+        }
+    }
+}
 
