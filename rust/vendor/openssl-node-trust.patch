+    /// Reads ordinary PEM certificates, retaining records before a parse error.
+    ///
+    /// AutoRouter's local compatibility extension. This has the same parser and
+    /// EOF rules as `stack_from_pem`, but exposes partial success as required by
+    /// Node's NODE_EXTRA_CA_CERTS loader. It does not load X509_AUX trust records.
+    pub fn stack_from_pem_partial(
