+    /// Reads ordinary PEM certificates, retaining records before a parse error.
+    ///
+    /// AutoRouter's local compatibility extension. This has the same parser and
+    /// EOF rules as `stack_from_pem`, but exposes partial success as required by
+    /// Node's NODE_EXTRA_CA_CERTS loader. It does not load X509_AUX trust records.
+    pub fn stack_from_pem_partial(
+        pem: &[u8],
+    ) -> Result<(Vec<X509>, Option<ErrorStack>), ErrorStack> {
+        unsafe {
+            ffi::init();
+            let bio = MemBioSlice::new(pem)?;
+            let mut certs = vec![];
+            loop {
+                let r =
+                    ffi::PEM_read_bio_X509(bio.as_ptr(), ptr::null_mut(), None, ptr::null_mut());
+                if r.is_null() {
+                    let error = ErrorStack::get();
+                    let eof = error.errors().last().is_some_and(|error| {
+                        error.library_code() == ffi::ERR_LIB_PEM as libc::c_int
+                            && error.reason_code() == ffi::PEM_R_NO_START_LINE as libc::c_int
+                    });
+                    return Ok((certs, if eof { None } else { Some(error) }));
+                }
+                certs.push(X509(r));
+            }
         }
     }
