+                    let error = ErrorStack::get();
+                    let eof = error.errors().last().is_some_and(|error| {
+                        error.library_code() == ffi::ERR_LIB_PEM as libc::c_int
+                            && error.reason_code() == ffi::PEM_R_NO_START_LINE as libc::c_int
+                    });
+                    return Ok((certs, if eof { None } else { Some(error) }));
+                }
+                certs.push(X509(r));
+            }
